# AI Gateway Configuration
GATEWAY_SECRET=your-gateway-secret-here

# LLM Provider API Keys (comma-separated for multiple keys)
CLINE_API_KEY=cline-key1,cline-key2
KILO_API_KEY=kilo-key1,kilo-key2
OPENROUTER_API_KEY=openrouter-key1,openrouter-key2
GEMINI_API_KEY=gemini-key1,gemini-key2,gemini-key3

# Supabase (for daily quota exhaustion tracking)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Custom reset times (ISO 8601 format, defaults to provider standards)
# GEMINI_RESET_HOUR=8
# CLINE_RESET_HOUR=0
# KILO_RESET_HOUR=0
# OPENROUTER_RESET_HOUR=0