# AI Gateway Configuration
GATEWAY_SECRET=your-gateway-secret-here

# OpenRouter API Keys (Primary: comma-separated for multiple keys / concurrency pool)
# 5~10+ keys supported for idle-first rotation & high concurrent requests
OPENROUTER_API_KEY=sk-or-v1-key1,sk-or-v1-key2,sk-or-v1-key3,sk-or-v1-key4,sk-or-v1-key5

# Optional LLM Provider API Keys (fallback if provided)
# CLINE_API_KEY=cline-key1,cline-key2
# KILO_API_KEY=kilo-key1,kilo-key2
# GEMINI_API_KEY=gemini-key1,gemini-key2

# Supabase (for daily quota exhaustion tracking)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Custom reset times
# OPENROUTER_RESET_HOUR=0