# ==============================================================================
# Reportist Video Environment Variables
# ==============================================================================

# Supabase 연동 (reportist-admin과 동일 프로젝트 공유 가능)
VITE_SUPABASE_URL=https://chlnkringpqsqtozuvah.supabase.co
VITE_SUPABASE_ANON_KEY=

# (선택 사항) Google YouTube Data API v3 키
# 설정하지 않아도 공식 YouTube oEmbed 및 자체 조회수 카운팅 시스템으로 100% 정상 작동합니다.
VITE_YOUTUBE_API_KEY=

# (선택 사항) AI 게이트웨이 시크릿
# 미설정 시 공용 무료 게이트웨이 시크릿이 사용됩니다.
# 주의: VITE_ 접두사 값은 빌드 시 클라이언트 번들에 포함됩니다.
#       운영 환경에서는 서버 프록시(/v1 리라이트에서 시크릿 주입) + Origin/Turnstile 제한을 권장합니다.
VITE_GATEWAY_SECRET=
