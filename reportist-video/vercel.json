{
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://seedtick-ai-gateway.vercel.app/v1/:path*"
    },
    {
      "source": "/health",
      "destination": "https://seedtick-ai-gateway.vercel.app/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.mp3)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ]
}
