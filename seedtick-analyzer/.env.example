# App 설정
ENV=development
LOG_LEVEL=INFO
DRY_RUN=true

# AI-Gateway 설정 (seedtick-ai-gateway)
AI_GATEWAY_URL=http://localhost:3000
AI_GATEWAY_MODEL=gemini-2.5-pro
AI_GATEWAY_SECRET=  # seedtick-ai-gateway의 GATEWAY_SECRET (옵션)
AI_CONCURRENCY=10  # 동시 처리 요청 수 (최대 10개 병렬)
AI_REQUEST_INTERVAL_SEC=0.0  # 요청 간 대기시간(초)

# Supabase 설정
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 증권사 연동 (Bridge)
# broker: mock | toss | kis
DEFAULT_BROKER=mock

# 토스증권 Open API (옵션)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT_SEQ=

# 한국투자증권 Open API (옵션)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_CANO=
KIS_ACNT_PRDT_CD=01

# 알림
DISCORD_WEBHOOK_URL=
