# Analyzer FastAPI 백엔드 URL (로컬 또는 Hugging Face Space URL)
NEXT_PUBLIC_ANALYZER_URL=http://localhost:8000

# Supabase 프로젝트 연결 (선택: 클라이언트 직접 조회용)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 포트원 V2 결제 (테스트 상점 ID는 포트원 관리자 콘솔에서 0원 발급 가능)
NEXT_PUBLIC_PORTONE_STORE_ID=store-xxxx

# 1) 정기 결제 (신용카드 등록 / 빌링키 발급용 채널키 - 필수)
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_BILLING=channel-key-xxxx

# 2) 일반 단건 결제 (1년 이용권 등 1회성 결제용 - 선택, 없으면 위 빌링 채널키 자동 폴백)
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_ONETIME=

# 3) 카카오페이/간편결제 전용 채널키 (선택)
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_EASYPAY=

# ---- 아래는 서버 전용: 절대 NEXT_PUBLIC_을 붙이지 말고 Vercel 환경변수에만 등록 ----
# 포트원 API 시크릿 (포트원 콘솔 > 결제 연동 > API 키). 없으면 confirm/cancel이 실패로 닫힘.
PORTONE_API_SECRET=

# Supabase service_role 키 (Supabase > Project Settings > API).
# 과금 쓰기(subscriptions/payment_transactions)는 서버만 수행하므로 필수.
SUPABASE_SERVICE_ROLE_KEY=

# 개발 시뮬레이션 허용 (로컬에서 실결제 없이 테스트할 때만 true, 운영은 비워둘 것)
ALLOW_DEV_SIMULATION=
NEXT_PUBLIC_ALLOW_DEV_SIMULATION=
